# Copy to .env and set every value locally. .env is gitignored.
# Do not put real passwords or tokens in this file.
# Changing DB_PASSWORD after the first start requires `docker compose down -v`
# for the SQL Server volume.

DB_PASSWORD=

KEYCLOAK_USER=
KEYCLOAK_PASSWORD=

RABBITMQ_USER=
RABBITMQ_PASSWORD=

UNLEASH_DB_PASSWORD=
UNLEASH_ADMIN_USERNAME=
UNLEASH_ADMIN_PASSWORD=
UNLEASH_ADMIN_TOKEN=
UNLEASH_BACKEND_TOKEN=

# MassTransit 8 does not require a license. Leave this empty.
MT_LICENSE=
# MT_LICENSE_PATH=

# Baked into the frontend image at build time. Rebuild the frontend after changing these.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
